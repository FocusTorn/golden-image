{
    "defaultVMProfile": "GoldenAuto_OG",
    
    //--------------------------------------------------------------------------- 
    //---  Shared Settings  -----------------------------------------------------
    //---------------------------------------------------------------------------

    "LocalProjectRoot": "P:/Projects/golden-image",

    "HostFileSystem": {



    },

    "VMFileSystem": {
        "HostVhdPath": "N:/VHD/Golden-Imaging.vhdx",
        "MainOSDrive": "C",
        "GuestStagingDrive": "D",
        "DVDBootDrive": "E",
        "StagingVolumeLabel": "Golden Imaging",
        "OfflinePath": "_offline",
        "InstallersPath": "installers",
        "ReturnPath": "return"
    },
    
    
    "VMCredentials": {
        "VMUser": "Administrator",
        "VMPassword": "654654",
        "UsePasswordCreds": false
    },


    //------------------------------------------------------------------------------- 
    //---  Profiles   ---------------------------------------------------------------
    //-------------------------------------------------------------------------------

    "VMProfiles": {
        "GoldenAuto_OG": {
            "HardwareTemplate": "OfflineSysprep",
            "VMDetails": {
                "VMName": "Golden Auto OG",
                // "OSImagePath": "N:/OS_Images/Win11_25H2_English_x64.iso",
                // "OSImagePath": "N:/OS_Images/Win11_Vanilla_ZeroTouch.iso",
                "OSImagePath": "N:/Win11_Pro_Tiny_Vanilla.iso",
                "UnattendIsoPath": "N:/unattend.iso",
                "OsVhdPath": "N:/VM/Golden Auto OG/Virtual Hard Disks/Golden_Auto_OS.vhdx",
                "VMHostname": "DESKTOP-GoldenAuto",
                "WimDestination": "N:/Win_11_GoldenAuto.wim",
                "MemoryStartupGB": 6
            }
        }
    },
    
    
    //------------------------------------------------------------------------------- 
    //---  Templates   --------------------------------------------------------------
    //-------------------------------------------------------------------------------
    
    "VMProvisioningTemplates": {
        "OfflineSysprep": {
            "NewOsVhdSizeGB": 80,
            "VmMachinePath": "default",
            "Generation": 2,
            "ProcessorCount": 4,
            "SwitchName": "Not Connected",
            "AttachStagingVhd": false,
            "EnableGuestServices": true,
            "EnableEnhancedSession": true,
            "DisableAutomaticCheckpoints": true,
            "DynamicMemoryEnabled": false,
            "MemoryStartupGB": 6,
            "MemoryPriority": 50,
            "ExposeVirtualizationExtensions": false,
            "EnableSecureBoot": true,
            "SecureBootTemplate": "MicrosoftWindows",
            "TpmEnabled": true
        },
        "StandardWindows": {
            "NewOsVhdSizeGB": 80,
            "VmMachinePath": "Z:/Virtuals/Hyper-V/",
            "Generation": 2,
            "ProcessorCount": 4,
            "SwitchName": "Default Switch",
            "AttachStagingVhd": true,
            "EnableGuestServices": true,
            "EnableEnhancedSession": true,
            "DisableAutomaticCheckpoints": true,
            "DynamicMemoryEnabled": false,
            "MemoryStartupGB": 6,
            "MemoryPriority": 50,
            "ExposeVirtualizationExtensions": false,
            "EnableSecureBoot": true,
            "SecureBootTemplate": "MicrosoftWindows",
            "TpmEnabled": true
        }
    }
}





